{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "gitmcp": {
      "type": "remote",
      "url": "https://gitmcp.io/docs",
      "enabled": true
    },
    "excalidraw": {
      "type": "remote",
      "url": "https://mcp.excalidraw.com",
      "enabled": true
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "nixos": {
      "type": "local",
      "command": ["mcp-nixos"]
    },
    "blender": {
      "type": "local",
      "command": ["blender-mcp"]
    },
    "wayback-machine": {
      "type": "local",
      "command": ["npx", "-y", "mcp-wayback-machine"],
      "environment": {
        "WAYBACK_ACCESS_KEY": "{env:WAYBACK_ACCESS_KEY}",
        "WAYBACK_SECRET_KEY": "{env:WAYBACK_SECRET_KEY}"
      }
    }
  },
  "permission": "allow",
  "lsp": true,
  "instructions": ["./AGENTS.md"],
  "plugin": ["opencode-browser-annotation-plugin"]
}
